{
  "manifest_version": 3,
  "name": "TxLens — Web3 Transaction Safety & Anti-Drainer Shield",
  "version": "1.0.0",
  "description": "Auto-scrape and verify transaction authenticity before signing in MetaMask or Rabby. Instant SAFE, MID, or RISK rating with top 3 reasons.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TxLens Security Shield"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
