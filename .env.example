# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://txlens:txlens@localhost:5432/txlens
POSTGRES_USER=txlens
POSTGRES_PASSWORD=txlens
POSTGRES_DB=txlens

# ─── Cache / Jobs ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Blockchain (EVM) ────────────────────────────────────────────────────
# Never hard-code a specific provider (Alchemy/Infura/QuickNode/etc) in code.
# Point this at any EVM JSON-RPC endpoint. Base Sepolia is the default
# development/test network for the MVP.
EVM_CHAIN=base-sepolia
EVM_RPC_URL=https://sepolia.base.org
EVM_CHAIN_ID=84532

# Optional: block explorer / indexer API, if used for contract verification
# lookups. Left blank by default.
EVM_EXPLORER_API_URL=
EVM_EXPLORER_API_KEY=

# ─── AI Provider ─────────────────────────────────────────────────────────
# Provider abstraction lives in services/ai-analyst — swap via config only.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=

# ─── MCP Server ──────────────────────────────────────────────────────────
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8765
# Backend base URL the MCP server calls — no /api/v1 suffix, the client
# (services/mcp-server/mcp_server/client.py) already adds that per-request.
TXLENS_API_URL=http://localhost:8000
# Bearer token the MCP server sends to the backend API (see
# apps/api/app/auth/) — since Phase 11, /transactions/analyze and all
# /policies endpoints require authentication. Obtain one via
# POST /api/v1/auth/login and set it here, or leave blank for a local
# dev backend that only exercises the still-public endpoints
# (wallets/contracts/tokens lookups, /health).
TXLENS_API_TOKEN=

# ─── Backend API ─────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Signs every JWT access token (app/auth/jwt.py) — anyone who knows this
# value can forge a valid login for any user. The default below is only
# accepted in API_ENV=development/test; main.py refuses to start with it
# in production. Generate a real one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=change-me-in-local-env
API_ENV=development
API_CORS_ORIGINS=http://localhost:3000

# ─── Frontend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── Rate limiting ───────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
